{
  "info": {
    "_postman_id": "b1a2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Backend NestJS Seed API",
    "description": "Colección didáctica. Rama 1: Users. Rama 2: + Products. Rama 3: + Orders con relaciones. Rama 4: + Filtros simples vía query params (QueryBuilder). Usa variables baseUrl, userId, productId, orderId. BaseUrl http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "1234567890" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Users",
      "description": "Rama 1 - CRUD Users con soft delete.",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": \"1234567890\",\n  \"name\": \"Usuario de prueba\",\n  \"email\": \"prueba@seed.local\",\n  \"age\": 25,\n  \"phone\": \"+573101234567\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users"
          }
        },
        { "name": "Listar usuarios", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users" } },
        { "name": "Consultar usuario", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users/{{userId}}" } },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuario de prueba actualizado\",\n  \"age\": 26\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        { "name": "Desactivar usuario", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/users/{{userId}}" } }
      ]
    },
    {
      "name": "Products",
      "description": "Rama 2 + Rama 4 filtros: ?name=whey&minPrice=50&maxPrice=200&minStock=1&maxStock=100. Guarda id en productId.",
      "item": [
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Proteína Whey\",\n  \"description\": \"Proteína aislada 900g sabor vainilla\",\n  \"price\": 129.9,\n  \"stock\": 50\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/products"
          }
        },
        { "name": "Listar productos", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products" } },
        { "name": "Consultar producto", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products/{{productId}}" } },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 119.9,\n  \"stock\": 45\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        { "name": "Eliminar producto (soft)", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/products/{{productId}}" } },
        {
          "name": "Filtrar por nombre",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products?name=whey" }
        },
        {
          "name": "Filtrar por rango precio",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products?minPrice=50&maxPrice=200" }
        },
        {
          "name": "Filtrar por stock y nombre",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products?name=prote&minStock=10&maxStock=100" }
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Rama 3 + Rama 4 filtros: ?status=PENDING&userId=1234567890. Relaciones User-Order-OrderItem-Product con transacción.",
      "item": [
        {
          "name": "Crear orden",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"1234567890\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Crear orden - 2 productos",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"1234567890\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 },\n    { \"productId\": \"{{productId}}\", \"quantity\": 3 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders"
          }
        },
        { "name": "Listar órdenes", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders" } },
        { "name": "Consultar orden", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}" } },
        { "name": "Órdenes por usuario", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders/user/{{userId}}" } },
        {
          "name": "Actualizar estado orden",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PAID\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        { "name": "Cancelar orden (restaura stock)", "request": { "method": "PUT", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}/cancel" } },
        { "name": "Eliminar orden", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/orders/{{orderId}}" } },
        {
          "name": "Filtrar órdenes por status",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders?status=PENDING" }
        },
        {
          "name": "Filtrar órdenes por usuario",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders?userId={{userId}}" }
        },
        {
          "name": "Filtrar por status y usuario",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders?status=PENDING&userId={{userId}}" }
        }
      ]
    }
  ]
}
